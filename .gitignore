*.biprivatekey

# Object files
*.obj
!*.obj.meta

# Mod runtime folders (empty at rest)
@AthenaRemastered/Events/
@AthenaRemastered/Exports/
@AthenaRemastered/Mission/
@AthenaRemastered/World/

# Mod folder: large server binaries are built/published, not tracked.
# (Server/wwwroot is tracked; the repo layout was flattened on 2026-11-22,
# @AthenaRemastered/ used to live under AthenaRemastered/.)
@AthenaRemastered/addons/*.bisign
@AthenaRemastered/Server/*.deps.json
@AthenaRemastered/Server/*.dll
@AthenaRemastered/Server/*.exe
@AthenaRemastered/Server/*.pdb
@AthenaRemastered/Server/*.runtimeconfig.json
@AthenaRemastered/Server/*.staticwebassets.endpoints.json
@AthenaRemastered/Server/appsettings*.json
@AthenaRemastered/Server/runtimes/
@AthenaRemastered/Server/web.config

# Compatibility alias used locally to preserve older launch params
@Athena Web Remastered/

# Debug screenshots
objects-with-runways.png

# Map cache
MapCache/

# Secrets (never commit)
.env
.env/
.env.*
